{
  "name": "manim-cli",
  "version": "0.1.0",
  "description": "Production-ready npm wrapper for Manim Community with agent workflows and multi-provider TTS",
  "type": "module",
  "bin": {
    "manim-cli": "./dist/bin.js"
  },
  "files": [
    "dist",
    "python",
    "runtime",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/bin.ts",
    "runtime:metadata": "node scripts/write-runtime-metadata.mjs",
    "runtime:pack": "node scripts/pack-runtime.mjs",
    "runtime:manifest": "node scripts/generate-runtime-manifest.mjs",
    "runtime:validate": "node scripts/validate-runtime-assets.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "manim",
    "tts",
    "cli",
    "openai",
    "kokoro",
    "qwen",
    "chatterbox"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "commander": "^13.1.0",
    "tar": "^7.4.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.1",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
